# ==========================================
# REQUIRED - Core API Keys
# ==========================================
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=rag-chatbot

# ==========================================
# OPTIONAL - Pinecone Configuration
# ==========================================
PINECONE_NAMESPACE=default
PINECONE_DIMENSION=384
PINECONE_METRIC=cosine
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ==========================================
# OPTIONAL - Embedding Configuration
# ==========================================
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MAX_WORKERS=4
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_DELAY=1.5

# ==========================================
# OPTIONAL - Chunking Configuration
# ==========================================
CHILD_CHUNK_SIZE=300
CHILD_CHUNK_OVERLAP=50
PARENT_CHUNK_SIZE=1200
PARENT_CHUNK_OVERLAP=200

# ==========================================
# OPTIONAL - Retrieval Configuration
# ==========================================
DENSE_TOP_K=10
SPARSE_TOP_K=10
RRF_K=60
FINAL_TOP_K=3
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_THRESHOLD=0.3
MIN_RELEVANCE_SCORE=0.25

# ==========================================
# OPTIONAL - Agent Configuration
# ==========================================
QUERY_REWRITER_MODEL=llama-3.1-8b-instant
QUERY_REWRITER_TEMPERATURE=0.0
INTENT_CONFIDENCE_THRESHOLD=0.7
CRAG_CONFIDENCE_THRESHOLD=0.3
WEB_FALLBACK_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5

# ==========================================
# OPTIONAL - Observability (Langfuse)
# ==========================================
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PROJECT_NAME=rag-engine

# ==========================================
# OPTIONAL - Application Limits
# ==========================================
MAX_QUESTION_LENGTH=2000
MAX_QUESTIONS_PER_SESSION=50
MAX_FILE_UPLOAD_MB=50
MAX_FILE_CONTENT_CHARS=200000

# ==========================================
# OPTIONAL - LangChain Tracing (Legacy)
# ==========================================
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=local-rag
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ==========================================
# OPTIONAL - Streamlit Server
# ==========================================
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0